# Entorno general
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Puertos HTTP
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
STUDENT_SERVICE_PORT=3002
GAMIFICATION_SERVICE_PORT=3003
RESOURCE_SERVICE_PORT=3004
SURVEY_SERVICE_PORT=3005
SUPPORT_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007
RECOMMENDATION_SERVICE_PORT=8000

# PostgreSQL local. Son credenciales de ejemplo exclusivas para desarrollo.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=vivu_admin
POSTGRES_ADMIN_PASSWORD=vivu_admin_dev_only
POSTGRES_DB=vivu
IDENTITY_DB_USER=identity_service
IDENTITY_DB_PASSWORD=identity_dev_only
STUDENT_DB_USER=student_service
STUDENT_DB_PASSWORD=student_dev_only
GAMIFICATION_DB_USER=gamification_service
GAMIFICATION_DB_PASSWORD=gamification_dev_only
RESOURCE_DB_USER=resource_service
RESOURCE_DB_PASSWORD=resource_dev_only
SURVEY_DB_USER=survey_service
SURVEY_DB_PASSWORD=survey_dev_only
SUPPORT_DB_USER=support_service
SUPPORT_DB_PASSWORD=support_dev_only
ANALYTICS_DB_USER=analytics_service
ANALYTICS_DB_PASSWORD=analytics_dev_only
RECOMMENDATION_DB_USER=recommendation_service
RECOMMENDATION_DB_PASSWORD=recommendation_dev_only

# RabbitMQ local
RABBITMQ_USER=vivu
RABBITMQ_PASSWORD=vivu_dev_only
RABBITMQ_URL=amqp://vivu:vivu_dev_only@localhost:5672

# Autenticación. Sustituir los valores en cualquier entorno compartido.
JWT_ISSUER=vivu
JWT_AUDIENCE=vivu-web
JWT_ACCESS_SECRET=replace_with_a_secure_value

# Recommendation Service y futuro proveedor LLM
RECOMMENDATION_ENV=development
LLM_PROVIDER=disabled
LLM_API_KEY=

